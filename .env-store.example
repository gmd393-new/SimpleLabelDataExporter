# Per-store production secrets — TEMPLATE
#
# Copy to .env-<store-slug> (gitignored) and fill in real values, then run:
#
#   bash scripts/set-store-secrets.sh .env-<store-slug>
#
# Never commit a filled-in copy. .gitignore covers .env-* — verify with:
#   git check-ignore .env-<store-slug>
#
# DATABASE_URL is NOT listed here: `flyctl postgres attach` sets it automatically.

# Fly app for this store
FLY_APP=

# Client ID from this store's Partners app (Configuration -> API credentials)
SHOPIFY_API_KEY=

# API secret key from the same page. Treat as a credential.
SHOPIFY_API_SECRET=

# Public URL of this store's deployment. Must exactly match the App URL set in
# the Partner Dashboard: https scheme, no trailing slash.
SHOPIFY_APP_URL=

# Must match the access scopes configured on the Partners app, or the merchant
# gets a re-authorization loop instead of a clear error.
SCOPES=write_products

# Lead digit + vendor code for generated UPCs. Item codes are allocated
# sequentially in the remaining digits, so the length matters: a 6-digit prefix
# leaves 5 digits (100,000 codes), a 7-digit prefix leaves 4 (10,000).
#
# REQUIRED. There is no default and the app will refuse to generate barcodes
# without it. Every store MUST get its OWN distinct prefix: item codes are
# allocated sequentially from each store's own database, so two stores that
# share a prefix (or both fall back to some default) WILL eventually issue
# identical UPCs. Changing a prefix after codes have been issued is not
# supported — it orphans the existing ledger entries.
UPC_PREFIX=

NODE_ENV=production
